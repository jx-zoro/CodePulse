generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspaces    WorkspaceMember[]
  auditLogs     AuditLog[]
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       WorkspaceMember[]
  projects      Project[]
  environments  Environment[]
  auditLogs     AuditLog[]
  webhooks      Webhook[]
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  role        String   @default("VIEWER") // OWNER, ADMIN, EDITOR, VIEWER
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Project {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  collections Collection[]
  securityFindings SecurityFinding[]
  mockConfigs MockConfig[]
  releases ApiRelease[]
  changes ApiChange[]
}

model Environment {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  type        String   @default("development")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  variables   EnvironmentVariable[]
}

model EnvironmentVariable {
  id            String   @id @default(uuid())
  environmentId String
  key           String
  value         String
  type          String   @default("default") // default, secret
  enabled       Boolean  @default(true)

  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
}

model Collection {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requests    ApiRequest[]
}

model ApiRequest {
  id           String   @id @default(uuid())
  collectionId String
  name         String
  method       String
  url          String
  body         String?
  bodyType     String   @default("none")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  headers      ApiHeader[]
  params       QueryParam[]
  testCases    TestCase[]
}

model ApiHeader {
  id        String   @id @default(uuid())
  requestId String
  key       String
  value     String
  enabled   Boolean  @default(true)

  request   ApiRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model QueryParam {
  id        String   @id @default(uuid())
  requestId String
  key       String
  value     String
  enabled   Boolean  @default(true)

  request   ApiRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model TestCase {
  id        String   @id @default(uuid())
  requestId String
  name      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  request   ApiRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  assertions Assertion[]
}

model Assertion {
  id            String   @id @default(uuid())
  testCaseId    String
  type          String
  target        String?
  expectedValue String?
  enabled       Boolean  @default(true)

  testCase      TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String?
  action      String
  resource    String
  metadata    String?  // JSON string
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Webhook {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  url         String
  secret      String?
  events      String   // Comma separated list of events
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model SecurityFinding {
  id              String   @id @default(uuid())
  projectId       String
  severity        String   @default("INFO") // INFO, LOW, MEDIUM, HIGH, CRITICAL
  category        String
  title           String
  description     String
  evidence        String?
  affectedEndpoint String?
  recommendation  String?
  status          String   @default("OPEN") // OPEN, ACKNOWLEDGED, RESOLVED, FALSE_POSITIVE
  createdAt       DateTime @default(now())
  resolvedAt      DateTime?

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model MockConfig {
  id            String   @id @default(uuid())
  projectId     String
  path          String
  method        String   @default("GET")
  statusCode    Int      @default(200)
  responseBody  String   @default("{}")
  headers       String   @default("[]") // JSON string of [{key, value}]
  latencyMs     Int      @default(0)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@unique([projectId, method, path])
}

model ApiRelease {
  id              String   @id @default(uuid())
  projectId       String
  version         String
  changelog       String?
  status          String   @default("DRAFT") // DRAFT, READY, RELEASED, DEPRECATED
  testStatus      String   @default("PENDING") // PENDING, PASS, FAIL
  securityStatus  String   @default("PENDING") // PENDING, PASS, FAIL
  createdAt       DateTime @default(now())
  releasedAt      DateTime?

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ApiChange {
  id              String   @id @default(uuid())
  projectId       String
  title           String
  description     String?
  affectedEndpoints String?
  status          String   @default("DRAFT") // DRAFT, IN_REVIEW, APPROVED, REJECTED, IMPLEMENTED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
